# dependencies
node_modules/

# build output
dist/
dist-ssr/
*.local

# environment — never commit real credentials
.env
.env.*
!.env.example

# test / tooling output
coverage/
.vitest/
test-results/
playwright-report/

# generated demo artifacts (large binaries; regenerated on demand)
# audio is committed deliberately: it is a deliverable, not a build artifact.
# screenshots/video renders are NOT committed.
screenshots/*.png
!screenshots/.gitkeep
video/render/
video/*.mp4

# editor / OS noise
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
*.log

# impeccable skill cache — local hook state, not project content
.impeccable/hook.cache.json
.impeccable/questions/*.log
